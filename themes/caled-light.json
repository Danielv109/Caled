    "foreground": "#283b30",
    "descriptionForeground": "#556858",
    "errorForeground": "#a83a36",
    "icon.foreground": "#526a56",
    "textLink.foreground": "#216646",
    "textLink.activeForeground": "#174c32",
    "textCodeBlock.background": "#e9ece3",
    "textBlockQuote.background": "#e9ece3",
    "textBlockQuote.border": "#7ca98d",
    "textPreformat.foreground": "#486424",
    "selection.background": "#c6dfca",
    "activityBar.background": "#f0f1e9",
    "activityBar.foreground": "#254e35",
    "activityBar.inactiveForeground": "#657767",
    "activityBar.border": "#d2dbcd",
    "activityBar.activeBorder": "#286c52",
    "activityBarBadge.background": "#286c52",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#eceee6",
    "sideBar.foreground": "#314835",
    "sideBar.border": "#d2dbcd",
    "sideBarTitle.foreground": "#334c39",
    "sideBarSectionHeader.background": "#e3e8dc",
    "sideBarSectionHeader.foreground": "#334c39",
    "sideBarSectionHeader.border": "#d2dbcd",
    "titleBar.activeBackground": "#f0f1e9",
    "titleBar.activeForeground": "#314835",
    "titleBar.inactiveBackground": "#f0f1e9",
    "titleBar.inactiveForeground": "#607161",
    "titleBar.border": "#d2dbcd",
    "commandCenter.background": "#e7ebdf",
    "commandCenter.foreground": "#405e45",
    "commandCenter.border": "#b7c6b4",
    "editor.background": "#f5f4ee",
    "editor.foreground": "#283b30",
    "editorLineNumber.foreground": "#72816f",
    "editorLineNumber.activeForeground": "#354e39",
    "editorCursor.foreground": "#286c52",
    "editor.selectionBackground": "#c6dfca",
    "editor.inactiveSelectionBackground": "#dce7d8",
    "editor.selectionHighlightBackground": "#bfdbc280",
    "editor.lineHighlightBackground": "#eceedf",
    "editor.findMatchBackground": "#e8d6a3",
    "editor.findMatchBorder": "#8f711f",
    "editor.findMatchHighlightBackground": "#e8d6a380",
    "editorWhitespace.foreground": "#b6c0ae",
    "editorIndentGuide.background1": "#d4dccd",
    "editorIndentGuide.activeBackground1": "#8caa8b",
    "editorBracketMatch.background": "#cce2cc",
    "editorBracketMatch.border": "#7da27e",
    "editorError.foreground": "#b3433c",
    "editorWarning.foreground": "#8e6c17",
    "editorInfo.foreground": "#3b7087",
    "editorGhostText.foreground": "#71846e",
    "editorGutter.addedBackground": "#4a8757",
    "editorGutter.deletedBackground": "#b45b51",
    "editorGutter.modifiedBackground": "#557f95",
    "editorGroup.border": "#ced8c6",
    "editorGroupHeader.tabsBackground": "#e9ede2",
    "editorGroupHeader.tabsBorder": "#d2dbcd",
    "tab.activeBackground": "#f5f4ee",
    "tab.activeForeground": "#284730",
    "tab.inactiveBackground": "#e9ede2",
    "tab.inactiveForeground": "#5c705f",
    "tab.border": "#e9ede2",
    "tab.activeBorderTop": "#286c52",
    "tab.activeBorder": "#f5f4ee",
    "tab.unfocusedActiveBorderTop": "#8ba28a",
    "button.background": "#286c52",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1b563f",
    "button.secondaryBackground": "#dce6d7",
    "button.secondaryForeground": "#29452f",
    "button.secondaryHoverBackground": "#cbdcc6",
    "input.background": "#fafaf4",
    "input.foreground": "#283b30",
    "input.border": "#99b199",
    "input.placeholderForeground": "#64775e",
    "inputOption.activeBackground": "#c5dfc9",
    "inputOption.activeBorder": "#558764",
    "inputOption.activeForeground": "#204f33",
    "dropdown.background": "#fafaf4",
    "dropdown.foreground": "#283b30",
    "dropdown.border": "#99b199",
    "list.activeSelectionBackground": "#c7dfc8",
    "list.activeSelectionForeground": "#1e4a2b",
    "list.inactiveSelectionBackground": "#dce6d5",
    "list.inactiveSelectionForeground": "#29452f",
    "list.hoverBackground": "#e0e9d9",
    "list.focusBackground": "#cde1cb",
    "list.focusForeground": "#29452f",
    "list.highlightForeground": "#215e38",
    "list.focusOutline": "#457f55",
    "tree.indentGuidesStroke": "#a9bea3",
    "badge.background": "#d0e4d0",
    "badge.foreground": "#295739",
    "panel.background": "#eceee6",
    "panel.border": "#c6d3be",
    "panelTitle.activeForeground": "#2c4a33",
    "panelTitle.inactiveForeground": "#66795f",
    "panelTitle.activeBorder": "#286c52",
    "statusBar.background": "#e1eadd",
    "statusBar.foreground": "#3f5d43",
    "statusBar.border": "#c7d6bf",
    "statusBar.noFolderBackground": "#e1eadd",
    "statusBar.debuggingBackground": "#eee0b7",
    "statusBar.debuggingForeground": "#634b12",
    "statusBarItem.remoteBackground": "#cadfc9",
    "statusBarItem.hoverBackground": "#cadfc9",
    "editorWidget.background": "#f0f3e8",
    "editorWidget.border": "#9eb794",
    "editorSuggestWidget.background": "#f0f3e8",
    "editorSuggestWidget.border": "#9eb794",
    "editorSuggestWidget.selectedBackground": "#c7dfc8",
    "editorHoverWidget.background": "#f0f3e8",
    "editorHoverWidget.border": "#9eb794",
    "quickInput.background": "#f0f3e8",
    "quickInput.foreground": "#314c34",
    "notificationCenterHeader.background": "#dde8d5",
    "notifications.background": "#f0f3e8",
    "notifications.foreground": "#314c34",
    "notifications.border": "#9eb794",
    "progressBar.background": "#3e8053",
    "scrollbarSlider.background": "#73956840",
    "scrollbarSlider.hoverBackground": "#73956865",
    "scrollbarSlider.activeBackground": "#73956885",
    "diffEditor.insertedTextBackground": "#80b57732",
    "diffEditor.removedTextBackground": "#cf8b8332",
    "gitDecoration.addedResourceForeground": "#357044",
    "gitDecoration.modifiedResourceForeground": "#83641b",
    "gitDecoration.deletedResourceForeground": "#a04d42",
    "gitDecoration.untrackedResourceForeground": "#39724a",
    "gitDecoration.ignoredResourceForeground": "#71836a",
    "terminal.background": "#eceee6",
    "terminal.foreground": "#283b30",
    "terminal.ansiBlack": "#354630",
    "terminal.ansiRed": "#a4483b",
    "terminal.ansiGreen": "#48752e",
    "terminal.ansiYellow": "#886720",
    "terminal.ansiBlue": "#3f7090",
    "terminal.ansiMagenta": "#865890",
    "terminal.ansiCyan": "#317c73",
    "terminal.ansiWhite": "#77896e"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#627758", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#476696" } },
    { "scope": ["string", "markup.inline.raw"], "settings": { "foreground": "#4d722b" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#8a6520" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#227458" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": { "foreground": "#716523" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#297350" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#426898" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#283b30" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#286c43", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["invalid"], "settings": { "foreground": "#a83a36" } }
  ]
}
