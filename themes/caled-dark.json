    "activityBar.inactiveForeground": "#8d9c92",
    "activityBar.border": "#29332d",
    "activityBar.activeBorder": "#9bd5b8",
    "activityBarBadge.background": "#7cbea0",
    "activityBarBadge.foreground": "#10271c",
    "sideBar.background": "#1d2320",
    "sideBar.foreground": "#d0dbd2",
    "sideBar.border": "#303a33",
    "sideBarTitle.foreground": "#c6d7cb",
    "sideBarSectionHeader.background": "#232b26",
