    "sideBarSectionHeader.border": "#303a33",
    "titleBar.activeBackground": "#171b1a",
    "titleBar.activeForeground": "#d9e0d9",
    "titleBar.inactiveBackground": "#171b1a",
    "titleBar.inactiveForeground": "#96a49a",
    "titleBar.border": "#303a33",
    "commandCenter.background": "#232b26",
    "commandCenter.foreground": "#c5d1c8",
    "commandCenter.border": "#3a463e",
    "editor.background": "#171b1a",
    "editor.foreground": "#dce4de",
    "editorLineNumber.foreground": "#76867a",
    "editorLineNumber.activeForeground": "#c0d2c3",
    "editorCursor.foreground": "#b9e6c6",
    "editor.selectionBackground": "#365344",
    "editor.inactiveSelectionBackground": "#2b3c32",
