    "editorInfo.foreground": "#91bbcc",
    "editorGhostText.foreground": "#8b9a91",
    "editorGutter.addedBackground": "#8bc8a3",
    "editorGutter.deletedBackground": "#df958c",
    "editorGutter.modifiedBackground": "#92bacc",
    "editorGroup.border": "#354037",
    "editorGroupHeader.tabsBackground": "#1d2320",
    "editorGroupHeader.tabsBorder": "#303a33",
    "tab.activeBackground": "#171b1a",
    "tab.activeForeground": "#e1ebe2",
    "tab.inactiveBackground": "#1d2320",
    "tab.inactiveForeground": "#a1b0a5",
    "tab.border": "#1d2320",
    "tab.activeBorderTop": "#86be9e",
    "tab.activeBorder": "#171b1a",
    "tab.unfocusedActiveBorderTop": "#557461",
    "button.background": "#9bd5b8",
    "button.foreground": "#142c20",
    "button.hoverBackground": "#b4e4c6",
    "button.secondaryBackground": "#303d34",
    "button.secondaryForeground": "#e2e9e2",
    "button.secondaryHoverBackground": "#3d4c42",
    "input.background": "#222a25",
    "input.foreground": "#e0e8e0",
    "input.border": "#4a594e",
    "input.placeholderForeground": "#a1b1a6",
    "inputOption.activeBackground": "#3f624e",
    "inputOption.activeBorder": "#8bbb9e",
    "inputOption.activeForeground": "#f1f7ee",
    "dropdown.background": "#262f29",
    "dropdown.foreground": "#dde6dc",
    "dropdown.border": "#4a594e",
    "list.activeSelectionBackground": "#355340",
    "list.activeSelectionForeground": "#f0f4ed",
    "list.inactiveSelectionBackground": "#29382e",
    "list.inactiveSelectionForeground": "#dce7de",
    "list.hoverBackground": "#29352c",
    "list.focusBackground": "#304d3c",
    "list.focusForeground": "#e7f1e8",
    "list.highlightForeground": "#b2e5c8",
    "list.focusOutline": "#87bb9e",
    "tree.indentGuidesStroke": "#4b5d50",
    "badge.background": "#355540",
    "badge.foreground": "#deefdf",
    "panel.background": "#1d2320",
    "panel.border": "#38443b",
    "panelTitle.activeForeground": "#e0ebe0",
    "panelTitle.inactiveForeground": "#a2b2a6",
    "panelTitle.activeBorder": "#9bd5b8",
    "statusBar.background": "#202c24",
    "statusBar.foreground": "#c6d7c9",
    "statusBar.border": "#35483b",
    "statusBar.noFolderBackground": "#202c24",
    "statusBar.debuggingBackground": "#53472b",
    "statusBar.debuggingForeground": "#f3e5c3",
    "statusBarItem.remoteBackground": "#35583e",
    "statusBarItem.hoverBackground": "#35483b",
    "editorWidget.background": "#232c25",
    "editorWidget.border": "#475a4c",
    "editorSuggestWidget.background": "#232c25",
    "editorSuggestWidget.border": "#475a4c",
    "editorSuggestWidget.selectedBackground": "#365541",
    "editorHoverWidget.background": "#232c25",
    "editorHoverWidget.border": "#475a4c",
    "quickInput.background": "#232c25",
    "quickInput.foreground": "#e0e9df",
    "notificationCenterHeader.background": "#2c3a30",
    "notifications.background": "#232c25",
    "notifications.foreground": "#e0e9df",
    "notifications.border": "#475a4c",
    "progressBar.background": "#92cca9",
    "scrollbarSlider.background": "#7b938350",
    "scrollbarSlider.hoverBackground": "#92af9c75",
    "scrollbarSlider.activeBackground": "#a1bbaa90",
    "diffEditor.insertedTextBackground": "#6caf8128",
    "diffEditor.removedTextBackground": "#d4877c28",
    "gitDecoration.addedResourceForeground": "#8ec89f",
    "gitDecoration.modifiedResourceForeground": "#d8c081",
    "gitDecoration.deletedResourceForeground": "#e4a096",
    "gitDecoration.untrackedResourceForeground": "#a1d6b0",
    "gitDecoration.ignoredResourceForeground": "#8b998f",
    "terminal.background": "#1d2320",
    "terminal.foreground": "#dce4de",
    "terminal.ansiBlack": "#303b32",
    "terminal.ansiRed": "#e4968e",
    "terminal.ansiGreen": "#98cba0",
    "terminal.ansiYellow": "#dbc58a",
    "terminal.ansiBlue": "#93bbd0",
    "terminal.ansiMagenta": "#c6acd5",
    "terminal.ansiCyan": "#91c9c2",
    "terminal.ansiWhite": "#dce4de"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#95a79a", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#b4c8ed" } },
    { "scope": ["string", "markup.inline.raw"], "settings": { "foreground": "#b4d49a" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#dfbd83" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8ed3be" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": { "foreground": "#d9cd9e" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#95cbb7" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#b6cceb" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#dce4de" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#b4dfbd", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["invalid"], "settings": { "foreground": "#efa19a" } }
  ]
}
